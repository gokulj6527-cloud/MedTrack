# MedTrack Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database Configuration
# Supported drivers: 'sqlite' or 'mysql' (e.g. Supabase MySQL or Postgres via compatible driver)
DB_DRIVER=sqlite
SQLITE_PATH=./server/medtrack.sqlite

# Supabase / MySQL Database Credentials (if DB_DRIVER=mysql)
DB_HOST=your-supabase-db-host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_NAME=postgres

# Supabase API (if direct Supabase client access is configured)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
