# ==============================================================================
# MedTrack Environment Configuration
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Database Configuration
# Supported DB_DRIVER values: 'postgres' (Supabase/PostgreSQL), 'sqlite', or 'mysql'
DB_DRIVER=postgres

# Option A (Recommended for Supabase): Connection Pooling or Direct URL
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@your-project-ref.supabase.co:5432/postgres

# Option B: Individual Database Parameters (Used if DATABASE_URL is not set)
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-database-password
DB_NAME=postgres
DB_SSL=true

# Option C: Local SQLite Development (Used if DB_DRIVER=sqlite)
SQLITE_PATH=./server/medtrack.sqlite

# Optional: Supabase API Keys (Server-side reference if using Supabase client libraries)
# NEVER prefix these with VITE_ to keep them private on the server
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
